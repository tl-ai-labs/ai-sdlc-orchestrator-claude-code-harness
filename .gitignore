# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# Build output for the bundled MCP server
plugin/mcp/gemini-flash-server/dist/

# The Antigravity agent worker's Python environment. Built on demand by the
# setup wizard (or `verify-setup.mjs --fix`) and only for installs that chose
# the agent path — the worker's source and its requirements.txt ARE tracked, so
# the environment is reproducible from the repo without being carried in it. It
# is also machine-specific: a virtualenv hardcodes the absolute path of the
# interpreter it was built from, so a committed one would be broken everywhere
# except the machine that made it.
plugin/mcp/gemini-flash-server/worker/.venv/
__pycache__/

# Ephemeral scratch dirs / one-off scripts that a subagent might leave
# under the MCP server dir during a run — never part of the release.
plugin/mcp/gemini-flash-server/_run*/
plugin/mcp/gemini-flash-server/*.mjs

# Raw model responses a subagent might dump at the repo root during
# debugging — never part of the release.
_raw_*.txt
_raw_*.json

# Run outputs — each user generates their own. /sdlc-run writes the generated
# application to src/ and the run record to .sdlc/ in whatever directory it was
# started from; a run started inside a clone would otherwise offer both for
# commit. /run-sdlc-pass writes under examples/<study-id>/passes/<run-id>/.
/src/
/.sdlc/
examples/*/passes/*/

# Generated MCP registration — contains absolute paths + copied API keys,
# per-machine, written by tools/setup.mjs
.mcp.json

# Local Claude Code repo-conventions file — kept out of the public repo
# on purpose; the durable rules live in CONTRIBUTING.md.
CLAUDE.md

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Hook heartbeat log written by plugin/hooks/telemetry.sh
.hook-logs/

# Claude Code project state (project-installed commands + agents)
.claude/
